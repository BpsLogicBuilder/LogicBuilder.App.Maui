<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
		<RootNamespace>LogicBuilder.App.Maui</RootNamespace>
		<PackageId>LogicBuilder.App.Maui</PackageId>
		<Authors>BlaiseD</Authors>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>true</WarningsAsErrors>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Description>Consolidates .NET MAUI UI generation functions into a shared library.</Description>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>First release.</PackageReleaseNotes>
		<PackageTags>.net maui</PackageTags>
		<Copyright>Copyright © BPS 2026</Copyright>
		<RepositoryUrl>https://github.com/BpsLogicBuilder/LogicBuilder.App.Maui</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/BpsLogicBuilder/LogicBuilder</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\icon.png" Pack="true" PackagePath="\" Visible="False" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Akavache.Sqlite3" Version="13.0.0" />
		<PackageReference Include="Akavache.SystemTextJson" Version="13.0.0" />
		<PackageReference Include="LogicBuilder.App.Bsl.Business" Version="1.0.3" />
		<PackageReference Include="LogicBuilder.App.Maui.AutoMapperProfiles" Version="1.0.2" />
		<PackageReference Include="LogicBuilder.App.Maui.Utils" Version="1.0.1" />
		<PackageReference Include="LogicBuilder.App.Maui.Forms.Configuration" Version="1.1.0" />
		<PackageReference Include="LogicBuilder.App.Utils" Version="1.0.9" />
		<PackageReference Include="LogicBuilder.Domain" Version="8.0.1" />
		<PackageReference Include="LogicBuilder.EntityFrameworkCore" Version="8.0.3" />
		<PackageReference Include="LogicBuilder.RulesDirector" Version="2.0.6" />
		<PackageReference Include="LogicBuilder.Structures" Version="8.1.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.120" />
		<PackageReference Include="Polly" Version="8.9.0" />
		<PackageReference Include="System.Reactive" Version="7.0.0" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
		<PackageReference Include="MinVer" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Views\BusyIndicator.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\Flyout.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MainPageView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MainPageViewDetail.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>
